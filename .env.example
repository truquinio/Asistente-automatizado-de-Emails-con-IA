# === OpenAI ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo-1106
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=500
OPENAI_TIMEOUT=30

# === Email (IMAP) ===
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
EMAIL_ACCOUNT=
EMAIL_PASSWORD=
EMAIL_FOLDERS=["INBOX","Important"]

# === Procesamiento ===
PROCESSING_LIMIT=10
PROCESSING_INTERVAL=300
MAX_EMAIL_SIZE=1048576

# === Respuestas ===
DEFAULT_TIMEZONE=America/Mexico_City
COMPANY_NAME=Mi Empresa
SUPPORT_EMAIL=soporte@miempresa.com

# === Seguridad ===
ALLOWED_DOMAINS=["gmail.com","miempresa.com"]
BLACKLIST=[]

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=email_assistant.log
LOG_ROTATION=10 MB
